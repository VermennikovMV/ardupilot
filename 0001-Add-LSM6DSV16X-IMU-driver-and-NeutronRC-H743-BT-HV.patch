diff --git a/libraries/AP_InertialSensor/AP_InertialSensor_LSM6DSV16X.cpp b/libraries/AP_InertialSensor/AP_InertialSensor_LSM6DSV16X.cpp
new file mode 100644
index 0000000..c337c8a
--- /dev/null
+++ b/libraries/AP_InertialSensor/AP_InertialSensor_LSM6DSV16X.cpp
@@ -0,0 +1,405 @@
+/*
+ * This file is free software: you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by the
+ * Free Software Foundation, either version 3 of the License, or
+ * (at your option) any later version.
+ *
